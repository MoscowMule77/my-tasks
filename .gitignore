# Files Git should ignore — never committed, never pushed.

# macOS clutter
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editor / IDE settings
.vscode/
.idea/

# Logs and temp files
*.log
*.tmp

# Dependencies (if we ever add a build step)
node_modules/

# Capacitor build output (generated by `npm run build`)
www/

# iOS native project — generated pieces we don't commit
ios/App/Pods/
ios/DerivedData/
